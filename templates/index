{% extends "base.html" %}

{% block title %}Главная - PickMe{% endblock %}

{% block content %}
<div class="hero-section text-white text-center py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <h1 class="display-3 fw-bold">Найди свою идеальную половинку</h1>
        <p class="lead fs-3 mt-3">PickMe - безопасный сервис знакомств с верификацией личности</p>
        {% if not current_user.is_authenticated %}
            <a href="{{ url_for('register') }}" class="btn btn-light btn-lg px-5 py-3 mt-4">
                <i class="fas fa-heart text-danger"></i> Начать знакомства
            </a>
        {% else %}
            <a href="#" class="btn btn-light btn-lg px-5 py-3 mt-4">
                <i class="fas fa-search"></i> Найти пару
            </a>
        {% endif %}
    </div>
</div>

<div class="container py-5">
    <h2 class="text-center mb-5">Почему PickMe?</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h4>Верификация личности</h4>
                    <p>Мы проверяем каждого пользователя, чтобы исключить фейковые аккаунты</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-chart-line fa-3x text-success mb-3"></i>
                    <h4>Умный подбор</h4>
                    <p>Алгоритм анализирует ваши предпочтения и находит совместимых партнеров</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-lock fa-3x text-info mb-3"></i>
                    <h4>Безопасное общение</h4>
                    <p>Чаты доступны только после взаимной симпатии</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bg-light py-5">
    <div class="container text-center">
        <h2 class="mb-4">Готовы найти любовь?</h2>
        <p class="lead">Присоединяйтесь к PickMe сегодня и начните знакомиться с проверенными людьми</p>
        {% if not current_user.is_authenticated %}
            <a href="{{ url_for('register') }}" class="btn btn-primary btn-lg mt-3">Зарегистрироваться бесплатно</a>
        {% endif %}
    </div>
</div>
{% endblock %}